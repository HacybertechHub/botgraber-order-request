{
  "version": 2,
  "name": "hacyberglobaltech-hub",
  "builds": [
    { "src": "app.js", "use": "@vercel/node" },
    { "src": "index.html", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/success", "dest": "/index.html" },
    { "src": "/webhook", "dest": "app.js" },
    { "src": "/telegram-webhook", "dest": "app.js" },
    { "src": "/flw-webhook", "dest": "app.js" }
  ],
  "env": {
    "BUSINESS_NAME": "HACYBERGLOBALTECH",
    "SUPPORT_PHONE": "+1 470-283-0342"
  }
}
